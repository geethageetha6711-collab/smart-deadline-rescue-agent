# Smart Deadline Rescue Agent - Environment Configuration

# Optional: Google Gemini API Key for AI natural language insights and recommendations
# If left blank or unset, the agent runs in 100% Deterministic Fallback Mode without errors.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use (default: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Server Configuration
PORT=8000
HOST=0.0.0.0
